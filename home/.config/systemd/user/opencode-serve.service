[Unit]
Description=opencode headless server for Tailscode
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
Environment=SHELL=/bin/bash
Environment=OPENCODE_CONFIG=%h/.config/opencode/opencode.local.json
Environment=PATH=%h/.local/bin:%h/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/lib/jvm/default/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl:/usr/lib/rustup/bin
EnvironmentFile=%h/.config/opencode-serve.env
ExecStart=/usr/bin/opencode serve --hostname 0.0.0.0 --port 4096 --print-logs
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
