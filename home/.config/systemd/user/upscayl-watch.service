[Unit]
Description=Image upscale+restore watch daemon (realesrgan ultrasharp 4x, compact re-encode)
Documentation=man:realesrgan-ncnn-vulkan(1)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/upscayl-watch
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

Nice=15
MemoryHigh=6G
MemoryMax=10G
CPUWeight=20
IOSchedulingClass=idle
IOWeight=20

NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
ReadWritePaths=%h/Pictures %h/.local/state/upscayl-watch /mnt/nvme8tb/Pictures

Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=upscayl-watch

[Install]
WantedBy=default.target
