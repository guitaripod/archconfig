[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = 1password

[Action]
Description = Letting 1password-mcp through the 1Password app's group check...
When = PostTransaction
Exec = /bin/sh -c 'chgrp onepassword /opt/1Password/1password-mcp && chmod g+s /opt/1Password/1password-mcp'
